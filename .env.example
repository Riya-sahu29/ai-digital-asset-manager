# Folder that contains the media to index (images, videos, PDFs)
MEDIA_DIR=./media
# Where SQLite DB + thumbnails are stored
DATA_DIR=./data

# Models (downloaded automatically on first run, ~600MB total)
CLIP_MODEL=clip-ViT-B-32
TEXT_MODEL=all-MiniLM-L6-v2

# Video: one frame every N seconds, capped at MAX_FRAMES per video
VIDEO_SECONDS_PER_FRAME=4
VIDEO_MAX_FRAMES=16

# PDF: how many pages to read / chars per text chunk / max chunks per file
PDF_MAX_PAGES=40
PDF_CHUNK_CHARS=800
PDF_MAX_CHUNKS=120

# Reliability / search
MAX_ATTEMPTS=3
MIN_SCORE=0.12
AUTO_INDEX=false

# Optional, only for scripts/fetch_dataset.py (free key from pexels.com/api)
PEXELS_API_KEY=
